#!/usr/bin/env python3
"""Regenerate _data/repos.yml, the data behind the repositories page.

    scripts/sync-repos                # rewrite _data/repos.yml
    scripts/sync-repos --check        # exit 1 if the committed file is stale
    scripts/sync-repos --since 2025-01-01

Requires the GitHub CLI, authenticated as someone who can read the account:

    gh auth status

The selection is deliberately mechanical: public, non-fork, non-archived
repositories with a push since --since (twelve months back by default). That
keeps the page on work that is current, and nothing on it is curated by hand
except the one-line descriptions GitHub does not already carry.

A repository with no description on GitHub is published only when
DESCRIPTIONS below supplies one written from the repository's contents. A
repository with nothing to describe is left out and recorded under `skipped`,
so the page never claims something a repository does not contain. Private
repositories never enter the file.

The site reads the file at build time (site.data.repos), so the page renders
with JavaScript disabled and makes no GitHub API call.
"""

import argparse
import json
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path

OWNER = "superposition"
DATA = Path(__file__).resolve().parent.parent / "_data" / "repos.yml"

# Repositories with no description on GitHub. Each line was written from the
# repository's own README and source, cited in the comment above it.
DESCRIPTIONS = {
    # docs/index.html is a wasm build; Cargo.toml is Bevy 0.16 + bevy_rapier3d.
    "cannoli-hell": "A cannoli-themed 3D arcade game in Bevy and Rapier, compiled to WebAssembly for the browser.",
    # README: "a Japanese document-reading arcade game served as an SSH app".
    "kotoba-line": "A Japanese document-reading arcade game played over SSH in the terminal.",
    # README: arrangement control for Ableton Live through a CLI, MCP and Max.
    "scenelab": "Template-driven arrangement control for Ableton Live, driven by a CLI and an MCP tool chain.",
    # README: ERC-8004 trustless agent registries in Solidity, Next.js front end.
    "newyears": "ERC-8004 trustless agent registries in Solidity on ROAX, with a Next.js front end.",
    # README: simulation in Zig compiled to WASM, rendering in WebGPU, Web Worker.
}

# Public repositories with nothing to describe: an empty repository, or a
# single stub README. Listed under `skipped` rather than published blank.
SKIP = {
    "ipc-hack": "no commits",
    "hardhat-bsc": "stub README only",
}

FIELDS = ",".join([
    "name",
    "description",
    "isPrivate",
    "isFork",
    "isArchived",
    "primaryLanguage",
    "stargazerCount",
    "pushedAt",
    "homepageUrl",
    "url",
])


def gh(*args):
    out = subprocess.run(["gh", *args], check=True, capture_output=True)
    return out.stdout.decode("utf-8")


def default_since():
    cutoff = datetime.utcnow() - timedelta(days=365)
    return cutoff.strftime("%Y-%m-%d")


def quote(value):
    """A YAML scalar that round-trips as the same string."""
    return json.dumps(value, ensure_ascii=False)


def render(owner, since, repos, skipped):
    lines = [
        "# Public repositories, generated by scripts/sync-repos. Do not edit by hand.",
        "# Selection: public, non-fork, pushed since %s." % since,
        "# Source: gh repo list %s" % owner,
        "owner: %s" % quote(owner),
        "since: %s" % quote(since),
    ]
    if skipped:
        lines.append("skipped:")
        for item in skipped:
            lines.append("  - name: %s" % quote(item["name"]))
            lines.append("    reason: %s" % quote(item["reason"]))
    else:
        lines.append("skipped: []")
    lines.append("repos:")
    for repo in repos:
        language = (repo.get("primaryLanguage") or {}).get("name")
        lines.append("  - name: %s" % quote(repo["name"]))
        lines.append("    description: %s" % quote(repo["description"]))
        lines.append("    url: %s" % quote(repo["url"]))
        if language:
            lines.append("    language: %s" % quote(language))
        lines.append("    stars: %d" % repo["stargazerCount"])
        lines.append("    pushed: %s" % quote(repo["pushedAt"][:10]))
        if repo.get("homepageUrl"):
            lines.append("    homepage: %s" % quote(repo["homepageUrl"]))
    return "\n".join(lines) + "\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--owner", default=OWNER)
    parser.add_argument("--since", default=default_since(),
                        help="ignore repositories last pushed before this date")
    parser.add_argument("--check", action="store_true",
                        help="verify the committed file instead of writing it")
    args = parser.parse_args()

    published = []
    skipped = []
    listed = json.loads(gh("repo", "list", args.owner, "--limit", "400",
                           "--json", FIELDS))
    for repo in listed:
        name = repo["name"]
        if repo["isPrivate"] or repo["isFork"] or repo["isArchived"]:
            continue
        if repo["pushedAt"][:10] < args.since:
            continue
        if name in SKIP:
            skipped.append({"name": name, "reason": SKIP[name]})
            continue
        repo["description"] = (repo["description"] or "").strip() or DESCRIPTIONS.get(name, "")
        if not repo["description"]:
            skipped.append({"name": name, "reason": "no description on GitHub"})
            continue
        published.append(repo)

    published.sort(key=lambda r: (r["pushedAt"], r["name"].lower()), reverse=True)
    text = render(args.owner, args.since, published, skipped)

    current = DATA.read_text(encoding="utf-8") if DATA.exists() else ""
    if args.check:
        if current != text:
            sys.stderr.write("_data/repos.yml is stale; run scripts/sync-repos\n")
            return 1
        return 0

    DATA.parent.mkdir(exist_ok=True)
    with open(DATA, "w", encoding="utf-8", newline="\n") as out:
        out.write(text)
    print("wrote %s: %d repositories, %d skipped"
          % (DATA.name, len(published), len(skipped)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
