{
  "name": "superposition-storybook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Storybook workbench for the Superposition component library. Imports the site's own stylesheets.",
  "scripts": {
    "storybook": "storybook dev -p 6017 --ci",
    "build-storybook": "storybook build",
    "test": "vitest run --project storybook",
    "test:watch": "vitest --project storybook",
    "a11y": "node scripts/a11y.mjs",
    "states": "node scripts/states.mjs",
    "slop": "node scripts/slop.mjs",
    "contrast": "node scripts/contrast.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/html-vite": "10.6.9",
    "@vitest/browser": "^5.1.2",
    "@vitest/browser-playwright": "^5.1.2",
    "axe-core": "^4.14.1",
    "playwright": "^1.65.1",
    "remark-gfm": "^4.0.1",
    "storybook": "10.6.9",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
