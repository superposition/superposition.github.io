---
permalink: /sitemap.xml
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- Every HTML page and every journal entry. A page opts out with `sitemap: false`
     in its front matter; the 404 page is never listed. lastmod is written only
     where the site knows a real date — a front matter `last_modified_at`, or the
     post's own date — so the file never claims a page changed at build time. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | sort: "url" %}
{%- for item in pages %}{% unless item.sitemap == false or item.url == '/404.html' %}
  <url>
    <loc>{{ item.url | absolute_url }}</loc>
{%- if item.last_modified_at %}
    <lastmod>{{ item.last_modified_at | date_to_xmlschema }}</lastmod>
{%- endif %}
  </url>
{%- endunless %}{% endfor %}
{%- for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>
{%- endfor %}
</urlset>
